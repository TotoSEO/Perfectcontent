{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.1",
      "includeFiles": "backend/app/**"
    }
  },
  "rewrites": [
    { "source": "/srv/:path*", "destination": "/api/index" },
    { "source": "/healthz/:path*", "destination": "/api/index" }
  ]
}
