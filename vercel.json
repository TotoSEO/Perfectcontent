{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/next" },
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.3.1",
      "config": { "includeFiles": "backend/**" }
    },
    { "src": "api/ping.py", "use": "@vercel/python@4.3.1" }
  ],
  "routes": [
    { "src": "/srv/diag", "dest": "/api/ping.py" },
    { "src": "/srv/(.*)", "dest": "/api/index.py" },
    { "src": "/healthz/(.*)", "dest": "/api/index.py" }
  ]
}
