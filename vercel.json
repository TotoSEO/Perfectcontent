{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/next" },
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.3.1",
      "config": {
        "includeFiles": "backend/app/**",
        "excludeFiles": "{node_modules,.next,.vercel,.git,public,.claude,scrapers,components,lib,app,backend/tests,backend/alembic,**/__pycache__,**/.mypy_cache,**/.ruff_cache,**/.pytest_cache}/**",
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    { "src": "/srv/(.*)", "dest": "/api/index.py" },
    { "src": "/healthz/(.*)", "dest": "/api/index.py" }
  ]
}
