{$DOMAIN} {
    encode zstd gzip

    # Block bots / search engines at the edge — defense in depth on top of meta robots
    @blocked_ua header_regexp User-Agent (?i)(bot|crawler|spider|scraper|slurp|baidu|yandex)
    handle @blocked_ua {
        respond 403
    }

    # Backend API + SSE
    handle /api/* {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
    handle /healthz* {
        reverse_proxy api:8000
    }

    # Everything else → Next.js
    handle {
        reverse_proxy frontend:3000
    }

    log {
        output stdout
        format console
    }
}
