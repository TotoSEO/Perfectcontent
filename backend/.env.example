ENV=dev

# DEV (local docker-compose):
DATABASE_URL=postgresql+asyncpg://perfectcontent:perfectcontent@localhost:5432/perfectcontent
# PROD (Supabase): grab the URI from Project Settings > Database > Connection string > URI,
# then change scheme to postgresql+asyncpg and use the "Session" pooler port (5432) or direct.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pwd>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6379/0

APP_PASSWORD=change-me
SESSION_SECRET=change-me-too-make-it-long-and-random

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
FIRECRAWL_API_KEY=
JINA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=
# Optional : raises the Google PageSpeed Insights quota (the API also works
# keyless). Create a free key at console.cloud.google.com (enable the
# "PageSpeed Insights API").
PAGESPEED_API_KEY=

COST_HARD_CAP_DEFAULT=1.00
MOCK_EXTERNAL=0
