# Public URL where the app is served, no trailing slash
DOMAIN=pc.exemple.com
PUBLIC_URL=https://pc.exemple.com

# ----- Backend (.env.prod is read by both api and worker containers) -----
ENV=prod

# Supabase Postgres — Project Settings → Database → Connection string → URI
# Replace <ref> and <pwd>, prefix scheme with postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pwd>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://redis:6379/0

# Strong password + 64-char random secret
APP_PASSWORD=change-me-very-strong
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Same-origin in our compose (Caddy proxies /api/* to api), so CORS allows the public URL
CORS_ORIGINS=https://pc.exemple.com

# API keys
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
FIRECRAWL_API_KEY=
JINA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=

COST_HARD_CAP_DEFAULT=1.00
MOCK_EXTERNAL=0
